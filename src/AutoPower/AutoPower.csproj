<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPower.Core\AutoPower.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Infrastructure\AdminElevationManager.cs" />
    <Compile Include="Infrastructure\StartupManager.cs" />
    <Compile Include="Infrastructure\Win32\Shell32.cs" />
    <Compile Include="UI\SettingsWindow.cs" />
    <Compile Include="UI\TrayIcon.cs" />
    <Compile Include="UI\ViewModels\DecisionTreeViewModel.cs" />
    <Compile Include="UI\ViewModels\ConditionGroupEditorViewModel.cs" />
    <Compile Include="UI\Components\ConditionGroupEditor.cs" />
    <Compile Include="UI\Components\TreeViewEditor.cs" />
    <Compile Include="UI\Components\CardViewEditor.cs" />
    <Compile Include="UI\Components\FlowchartView.cs" />
    <Compile Include="UI\Components\DecisionTreeMutation.cs" />
    <Compile Include="UI\Components\DecisionTreeEditor.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Platform.Win32" Version="0.15.2" />
    <PackageReference Include="Aprillz.MewUI.Windows" Version="0.15.2" />
  </ItemGroup>

</Project>
